TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token
PORT=3000

# Crisp plugin credentials — needed by tag_case and any other tool that writes back to Crisp
CRISP_WEBSITE_ID=your_crisp_website_id
CRISP_IDENTIFIER=your_crisp_plugin_identifier
CRISP_KEY=your_crisp_plugin_key

# n8n webhook that proxies Shopify Partner API — used by check_subscription + get_billing_history
# Leave unset to fall back to local fixtures for offline dev.
N8N_WEBHOOK_URL=https://workflow.bravebits.co/webhook/partner-store
N8N_API_KEY=your_n8n_api_key
